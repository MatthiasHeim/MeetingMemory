<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.transcribewatcher</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/Matthias/Desktop/Repos/MeetingMemory/venv/bin/python</string>
        <string>/Users/Matthias/Desktop/Repos/MeetingMemory/tools/transcribe_watcher.py</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Crash-only restart: do NOT respawn on a clean/manual exit (a bare
         KeepAlive=true respawned even after `bootout`, fighting any stop).
         Combined with ThrottleInterval below this prevents a tight respawn
         loop from piling load onto launchd/sandboxd. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- ROOT CAUSE of the exit-78 crash loop. These MUST live outside the
         TCC-protected ~/Documents. After the macOS update on 2026-05-30, the
         per-user launchd lost permission to OPEN std-io files inside
         ~/Documents/MeetingRecorder/logs/, so every spawn failed std-io setup
         and launchd recorded EX_CONFIG (78) -> KeepAlive respawn -> crash loop.
         (The app's own logs via Python still write to ~/Documents fine, because
         that access is in-session; only launchd's redirection broke.)
         ~/Library/Logs is the conventional, non-TCC location for agent logs. -->
    <key>StandardOutPath</key>
    <string>/Users/Matthias/Library/Logs/MeetingRecorder/watcher_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/Matthias/Library/Logs/MeetingRecorder/watcher_stderr.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/Matthias/Desktop/Repos/MeetingMemory</string>

    <!-- Deliberately a background daemon (NO LimitLoadToSessionType=Aqua).
         The interpreter lives under the TCC-protected ~/Desktop; in an Aqua
         (GUI-session) agent, Python's startup open() of the venv triggers a
         blocking TCC consent prompt and the process hangs forever in
         getpath_readlines. A non-Aqua daemon is granted that access silently
         and runs fine (verified 2026-05-30). FSEvents + ~/Documents data access
         work fine from a daemon; only launchd's std-io redirect needed moving
         out of ~/Documents (see StandardOutPath above). -->

    <!-- Quota isolation (2026-07-10 incident): the fire-and-forget headless
         `claude -p /meeting-actions` sessions this watcher spawns get their OWN
         Claude quota pool via CLAUDE_CONFIG_DIR, so automation stops competing
         with interactive usage for one shared pool (which is what starved every
         session into a "session limit" death, silently dropping all downstream
         actions). Quota is keyed by CLAUDE_CONFIG_DIR. The watcher forwards this
         to the child session (see transcribe_watcher._trigger_claude).
         ONE-TIME: `CLAUDE_CONFIG_DIR=/Users/Matthias/.claude-automation claude`
         then run /login there. See tools/CLAUDE_QUOTA_ISOLATION.md. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Users/Matthias/.local/bin</string>
        <key>CLAUDE_CONFIG_DIR</key>
        <string>/Users/Matthias/.claude-automation</string>
    </dict>

    <!-- Minimum seconds between (re)launches. Was 10s, which let a fast-failing
         watcher respawn ~6x/min. The watcher is headless and cannot itself
         crash WindowServer, but a tight loop still loads launchd/sandboxd. -->
    <key>ThrottleInterval</key>
    <integer>30</integer>
</dict>
</plist>
